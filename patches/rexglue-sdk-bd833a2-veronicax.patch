+void PhysicalHeap::InvalidateGpuData(uint32_t address, uint32_t size, uint32_t allocation_type) {
+  // A new allocation belongs to the CPU, so drop any GPU-side copy of it.
+  // Release only invalidates pages watched in the releasing heap, and GPU
+  // writes that land after a release (or in pages no view had committed) are
+  // never watched at all: the GPU would keep its stale copy and miss every CPU
+  // write to the new allocation (corrupted second intro FMV and textures).
+  if (!(allocation_type & memory::kMemoryAllocationCommit) || !size) {
+    return;
+  }
+  uint32_t physical_address = GetPhysicalAddress(address);
+  for (auto invalidation_callback : memory_->physical_memory_invalidation_callbacks_) {
+    invalidation_callback->first(invalidation_callback->second, physical_address, size, true);
+  }
+}
